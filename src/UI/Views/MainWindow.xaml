<Window x:Class="UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MAIN_SYSTEM" Height="900" Width="1650" Background="#F6F8FC">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Content="⚙️" Width="36" Height="36" FontSize="16" Command="{Binding OpenSettingsCommand}"/>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="Создать проект" Command="{Binding CreateProjectCommand}" Margin="0,0,8,0"/>
                <Button Content="Пересчитать" Command="{Binding RecalculateCommand}" Margin="0,0,8,0"/>
                <TextBlock VerticalAlignment="Center" Margin="8,0,4,0" Text="Период: с"/>
                <DatePicker SelectedDate="{Binding From}" Margin="0,0,8,0"/>
                <TextBlock VerticalAlignment="Center" Margin="8,0,4,0" Text="по"/>
                <DatePicker SelectedDate="{Binding To}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Путь: " Foreground="#64748B"/>
                <TextBlock Text="{Binding CurrentExcelPath}" FontWeight="SemiBold"/>
                <TextBlock Text="   |   Статус: " Foreground="#64748B" Margin="14,0,0,0"/>
                <TextBlock Text="{Binding SaveState}"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Файлы">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Новый" Command="{Binding NewFileCommand}" Margin="0,0,8,8"/>
                        <Button Content="Открыть (.xlsx)" Command="{Binding OpenExcelCommand}" Margin="0,0,8,8"/>
                        <Button Content="Сохранить" Command="{Binding SaveExcelCommand}" Margin="0,0,8,8"/>
                        <Button Content="Сохранить как…" Command="{Binding SaveAsExcelCommand}" Margin="0,0,8,8"/>
                        <Button Content="Экспорт" Command="{Binding ExportExcelCommand}" Margin="0,0,8,8"/>
                        <Button Content="Импорт" Command="{Binding ImportExcelCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ValidationLog}" HeadersVisibility="None"/>
                </Grid>
            </TabItem>

            <TabItem Header="Товары"><DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="True"/></TabItem>
            <TabItem Header="Курсы валют"><DataGrid ItemsSource="{Binding FxRates}" AutoGenerateColumns="True"/></TabItem>
            <TabItem Header="Закупки"><DataGrid ItemsSource="{Binding Purchases}" AutoGenerateColumns="True"/></TabItem>
            <TabItem Header="Логистика"><DataGrid ItemsSource="{Binding Logistics}" AutoGenerateColumns="True"/></TabItem>
            <TabItem Header="Продажи"><DataGrid ItemsSource="{Binding Sales}" AutoGenerateColumns="True"/></TabItem>
            <TabItem Header="Маркетинг"><DataGrid ItemsSource="{Binding Marketing}" AutoGenerateColumns="True"/></TabItem>
            <TabItem Header="Прочие расходы"><DataGrid ItemsSource="{Binding OtherCosts}" AutoGenerateColumns="True"/></TabItem>
            <TabItem Header="Склад"><DataGrid ItemsSource="{Binding Inventory}" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem>
            <TabItem Header="Юнит-экономика"><DataGrid ItemsSource="{Binding UnitEconomics}" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem>
            <TabItem Header="P&amp;L + KPI">
                <StackPanel Margin="12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="P&amp;L + KPI"/>
                    <TextBlock Foreground="#64748B" Text="Карточки KPI и аналитические графики" Margin="0,6,0,12"/>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Border Margin="0,0,8,0" Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock Text="Выручка"/><TextBlock Text="—" FontSize="24"/></StackPanel></Border>
                        <Border Margin="0,0,8,0" Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock Text="Чистая прибыль"/><TextBlock Text="—" FontSize="24"/></StackPanel></Border>
                        <Border Margin="0,0,8,0" Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock Text="Маржа"/><TextBlock Text="—" FontSize="24"/></StackPanel></Border>
                        <Border Padding="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel><TextBlock Text="ROI"/><TextBlock Text="—" FontSize="24"/></StackPanel></Border>
                    </UniformGrid>
                </StackPanel>
            </TabItem>
            <TabItem Header="Аналитика/Диаграммы">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Пользовательские таблицы и диаграммы (линейная/столбчатая/круговая)" FontWeight="SemiBold"/>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,12,0,0">
                        <Border Margin="0,0,8,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"><TextBlock Text="Линейная диаграмма" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Margin="0,0,8,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"><TextBlock Text="Столбчатая диаграмма" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"><TextBlock Text="Круговая диаграмма" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </UniformGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#111827" CornerRadius="10" Padding="8" Margin="0,10,0,0" Opacity="0.95">
            <TextBlock Text="{Binding ToastMessage}" Foreground="White"/>
        </Border>
    </Grid>
</Window>
