<Window x:Class="UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:UI.Infrastructure"
        mc:Ignorable="d"
        Title="MAIN_SYSTEM" Height="900" Width="1600"
        Background="#F6F8FC"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <infra:EnumLocalizationConverter x:Key="EnumLoc"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E2E8F0"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C7D2FE"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="VerticalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#FBFDFF"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF2FF"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Создать проект" Command="{Binding CreateProjectCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Пересчитать" Command="{Binding RecalculateCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Text="Офлайн-учет: закупки, продажи, склад, юнит-экономика"/>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="8,0,4,0" Text="Период: с"/>
                <DatePicker Grid.Column="4" SelectedDate="{Binding From}"/>
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,4,0" Text="по"/>
                    <DatePicker SelectedDate="{Binding To}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SectionCardStyle}">
                    <Expander Header="📦 Товары" IsExpanded="True">
                        <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Category}"/>
                                <DataGridTextColumn Header="Целевая закупка (CNY)" Binding="{Binding PurchaseTargetCny, StringFormat=N2}"/>
                                <DataGridTextColumn Header="Вес (кг)" Binding="{Binding WeightKg, StringFormat=N2}"/>
                                <DataGridTextColumn Header="Габариты" Binding="{Binding DimensionsText}"/>
                                <DataGridTextColumn Header="Упаковка (руб/шт)" Binding="{Binding PackagingRubPerUnit, StringFormat=N2}"/>
                                <DataGridTextColumn Header="Мин. маржа (%)" Binding="{Binding MinMarginPct, StringFormat=N2}"/>
                                <DataGridTextColumn Header="Целевая цена (руб)" Binding="{Binding TargetPriceRub, StringFormat=N2}"/>
                                <DataGridTemplateColumn Header="Статус">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,4" CornerRadius="12" HorizontalAlignment="Left" Background="#DCFCE7">
                                                <TextBlock Foreground="#166534" FontWeight="SemiBold" FontSize="12" Text="{Binding Status, Converter={StaticResource EnumLoc}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}"><Expander Header="💱 Курсы валют"><DataGrid ItemsSource="{Binding FxRates}" AutoGenerateColumns="False" MaxHeight="220"><DataGrid.Columns><DataGridTextColumn Header="Дата курса" Binding="{Binding FxDate, StringFormat=dd.MM.yyyy}"/><DataGridTextColumn Header="Курс CNY→RUB" Binding="{Binding CnyToRub, StringFormat=N4}"/></DataGrid.Columns></DataGrid></Expander></Border>
                <Border Style="{StaticResource SectionCardStyle}"><Expander Header="🧾 Закупки"><DataGrid ItemsSource="{Binding Purchases}" AutoGenerateColumns="False" MaxHeight="260"><DataGrid.Columns><DataGridTextColumn Header="ID закупки" Binding="{Binding PurchaseId}"/><DataGridTextColumn Header="Дата оплаты" Binding="{Binding PaidDate, StringFormat=dd.MM.yyyy}"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Количество" Binding="{Binding Qty}"/><DataGridTextColumn Header="Цена за единицу (CNY)" Binding="{Binding UnitPriceCny, StringFormat=N2}"/><DataGridTextColumn Header="Комиссии (CNY)" Binding="{Binding FeesCny, StringFormat=N2}"/></DataGrid.Columns></DataGrid></Expander></Border>
                <Border Style="{StaticResource SectionCardStyle}"><Expander Header="🚚 Логистика"><DataGrid ItemsSource="{Binding Logistics}" AutoGenerateColumns="False" MaxHeight="260"><DataGrid.Columns><DataGridTextColumn Header="ID логистики" Binding="{Binding LogId}"/><DataGridTextColumn Header="ID закупки" Binding="{Binding PurchaseId}"/><DataGridTextColumn Header="Доставка (руб)" Binding="{Binding DeliveryRub, StringFormat=N2}"/><DataGridTextColumn Header="Таможня (руб)" Binding="{Binding CustomsRub, StringFormat=N2}"/><DataGridTextColumn Header="Прочее (руб)" Binding="{Binding OtherRub, StringFormat=N2}"/></DataGrid.Columns></DataGrid></Expander></Border>
                <Border Style="{StaticResource SectionCardStyle}"><Expander Header="🛍 Продажи"><DataGrid ItemsSource="{Binding Sales}" AutoGenerateColumns="False" MaxHeight="280"><DataGrid.Columns><DataGridTextColumn Header="ID заказа" Binding="{Binding OrderId}"/><DataGridTextColumn Header="Дата продажи" Binding="{Binding SaleDate, StringFormat=dd.MM.yyyy}"/><DataGridTextColumn Header="Маркетплейс" Binding="{Binding Marketplace, Converter={StaticResource EnumLoc}}"/><DataGridTextColumn Header="Тип продажи" Binding="{Binding SaleType, Converter={StaticResource EnumLoc}}"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Количество" Binding="{Binding Qty}"/><DataGridTextColumn Header="Цена (руб)" Binding="{Binding PriceRub, StringFormat=N2}"/><DataGridTextColumn Header="Комиссия (руб)" Binding="{Binding CommissionRub, StringFormat=N2}"/><DataGridTextColumn Header="Логистика МП (руб)" Binding="{Binding MpLogisticsRub, StringFormat=N2}"/><DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource EnumLoc}}"/></DataGrid.Columns></DataGrid></Expander></Border>
                <Border Style="{StaticResource SectionCardStyle}"><Expander Header="📣 Маркетинг"><DataGrid ItemsSource="{Binding Marketing}" AutoGenerateColumns="False" MaxHeight="240"><DataGrid.Columns><DataGridTextColumn Header="ID маркетинга" Binding="{Binding MarketingId}"/><DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}"/><DataGridTextColumn Header="Маркетплейс" Binding="{Binding Marketplace, Converter={StaticResource EnumLoc}}"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Сумма (руб)" Binding="{Binding AmountRub, StringFormat=N2}"/><DataGridTextColumn Header="Тип" Binding="{Binding Type}"/></DataGrid.Columns></DataGrid></Expander></Border>
                <Border Style="{StaticResource SectionCardStyle}"><Expander Header="💸 Прочие расходы"><DataGrid ItemsSource="{Binding OtherCosts}" AutoGenerateColumns="False" MaxHeight="240"><DataGrid.Columns><DataGridTextColumn Header="ID расхода" Binding="{Binding CostId}"/><DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}"/><DataGridTextColumn Header="Тип расхода" Binding="{Binding CostType, Converter={StaticResource EnumLoc}}"/><DataGridTextColumn Header="Сумма (руб)" Binding="{Binding AmountRub, StringFormat=N2}"/><DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}"/></DataGrid.Columns></DataGrid></Expander></Border>
                <Border Style="{StaticResource SectionCardStyle}"><Expander Header="🏬 Склад"><DataGrid ItemsSource="{Binding Inventory}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Поступило (шт)" Binding="{Binding TotalInQty}"/><DataGridTextColumn Header="Выбыло (шт)" Binding="{Binding TotalOutQty}"/><DataGridTextColumn Header="Возвраты (шт)" Binding="{Binding TotalReturnQty}"/><DataGridTextColumn Header="Остаток (шт)" Binding="{Binding StockQty}"/><DataGridTextColumn Header="Ср. себестоимость (руб/шт)" Binding="{Binding AvgCostRubPerUnit, StringFormat=N2}"/><DataGridTextColumn Header="Стоимость остатков (руб)" Binding="{Binding StockValueRub, StringFormat=N2}"/></DataGrid.Columns></DataGrid></Expander></Border>
                <Border Style="{StaticResource SectionCardStyle}"><Expander Header="📈 Юнит-экономика"><DataGrid ItemsSource="{Binding UnitEconomics}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Ср. цена продажи (руб)" Binding="{Binding AvgSalePrice, StringFormat=N2}"/><DataGridTextColumn Header="Ср. комиссия (руб/шт)" Binding="{Binding AvgCommissionPerUnit, StringFormat=N2}"/><DataGridTextColumn Header="Ср. логистика МП (руб/шт)" Binding="{Binding AvgMpLogisticsPerUnit, StringFormat=N2}"/><DataGridTextColumn Header="Реклама (руб/шт)" Binding="{Binding AdsPerUnit, StringFormat=N2}"/><DataGridTextColumn Header="Ср. себестоимость (руб/шт)" Binding="{Binding AvgCostUnit, StringFormat=N2}"/><DataGridTextColumn Header="Упаковка (руб/шт)" Binding="{Binding PackagingPerUnit, StringFormat=N2}"/><DataGridTextColumn Header="Полная себестоимость (руб/шт)" Binding="{Binding FullCostPerUnit, StringFormat=N2}"/><DataGridTextColumn Header="Валовая прибыль (руб/шт)" Binding="{Binding GrossProfitPerUnit, StringFormat=N2}"/><DataGridTextColumn Header="Чистая прибыль (руб/шт)" Binding="{Binding NetProfitPerUnit, StringFormat=N2}"/><DataGridTextColumn Header="ROI (%)" Binding="{Binding RoiPct, StringFormat=N2}"/><DataGridTextColumn Header="Доля самовыкупа (%)" Binding="{Binding SelfBuySharePct, StringFormat=N2}"/></DataGrid.Columns></DataGrid></Expander></Border>

                <Border Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Text="P&amp;L + KPI (Прибыль и убытки + показатели)"/>
                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" Padding="12"><StackPanel><TextBlock Text="Выручка" Foreground="#64748B"/><TextBlock Text="—" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/></StackPanel></Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" Padding="12"><StackPanel><TextBlock Text="Чистая прибыль" Foreground="#64748B"/><TextBlock Text="—" FontSize="22" FontWeight="Bold" Foreground="#22C55E"/></StackPanel></Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" Padding="12"><StackPanel><TextBlock Text="Маржа" Foreground="#64748B"/><TextBlock Text="—" FontSize="22" FontWeight="Bold" Foreground="#4F46E5"/></StackPanel></Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="ROI" Foreground="#64748B"/><TextBlock Text="—" FontSize="22" FontWeight="Bold" Foreground="#06B6D4"/></StackPanel></Border>
                        </UniformGrid>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                            <TextBlock Text="Плейсхолдер под графики P&amp;L/KPI" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
