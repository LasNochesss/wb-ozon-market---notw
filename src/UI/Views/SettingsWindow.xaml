<Window x:Class="UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="320" Width="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Язык интерфейса"/>
        <ComboBox x:Name="LanguageBox" Grid.Row="1" Margin="0,6,0,12">
            <ComboBoxItem Content="Русский" Tag="ru-RU"/>
            <ComboBoxItem Content="Английский" Tag="en-US"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Text="Тема"/>
        <ComboBox x:Name="ThemeBox" Grid.Row="3" Margin="0,6,0,12">
            <ComboBoxItem Content="Светлая" Tag="Light"/>
            <ComboBoxItem Content="Тёмная" Tag="Dark"/>
            <ComboBoxItem Content="Пользовательский цвет" Tag="Custom"/>
        </ComboBox>

        <CheckBox x:Name="AutoSaveBox" Grid.Row="4" Content="Автосохранение (опционально)"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0" Content="Отмена" IsCancel="True"/>
            <Button Width="90" Content="ОК" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
