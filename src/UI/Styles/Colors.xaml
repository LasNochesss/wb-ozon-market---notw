<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Bg.Canvas">#F7F6F3</Color>
    <Color x:Key="Color.Bg.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Bg.Surface.Soft">#FCFCFA</Color>
    <Color x:Key="Color.Border.Default">#E7E5DF</Color>
    <Color x:Key="Color.Border.Strong">#D9D6CE</Color>
    <Color x:Key="Color.Text.Primary">#161A22</Color>
    <Color x:Key="Color.Text.Secondary">#6A7280</Color>
    <Color x:Key="Color.Text.Tertiary">#9097A3</Color>
    <Color x:Key="Color.Accent.Primary">#2F3E6E</Color>
    <Color x:Key="Color.Accent.Primary.Hover">#26355F</Color>
    <Color x:Key="Color.Accent.Secondary">#6B7280</Color>
    <Color x:Key="Color.State.Success">#2E8B57</Color>
    <Color x:Key="Color.State.Success.Bg">#EAF6EF</Color>
    <Color x:Key="Color.State.Warning">#B7791F</Color>
    <Color x:Key="Color.State.Warning.Bg">#FFF6E8</Color>
    <Color x:Key="Color.State.Error">#C2413B</Color>
    <Color x:Key="Color.State.Error.Bg">#FDEEEE</Color>
    <Color x:Key="Color.Focus.Ring">#9AA8D6</Color>

    <SolidColorBrush x:Key="Brush.Bg.Canvas" Color="{StaticResource Color.Bg.Canvas}"/>
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="{StaticResource Color.Bg.Surface}"/>
    <SolidColorBrush x:Key="Brush.Bg.Surface.Soft" Color="{StaticResource Color.Bg.Surface.Soft}"/>
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}"/>
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}"/>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}"/>
    <SolidColorBrush x:Key="Brush.Accent.Primary.Hover" Color="{StaticResource Color.Accent.Primary.Hover}"/>
    <SolidColorBrush x:Key="Brush.State.Success" Color="{StaticResource Color.State.Success}"/>
    <SolidColorBrush x:Key="Brush.State.Warning" Color="{StaticResource Color.State.Warning}"/>
    <SolidColorBrush x:Key="Brush.State.Error" Color="{StaticResource Color.State.Error}"/>
</ResourceDictionary>
