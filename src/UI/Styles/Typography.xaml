<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <FontFamily x:Key="Font.Ui">Segoe UI Variable</FontFamily>
    <FontFamily x:Key="Font.Numeric">Bahnschrift</FontFamily>

    <sys:Double x:Key="Font.Size.Display">28</sys:Double>
    <sys:Double x:Key="Font.Size.H1">22</sys:Double>
    <sys:Double x:Key="Font.Size.H2">18</sys:Double>
    <sys:Double x:Key="Font.Size.TableHeader">13</sys:Double>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.Caption">12</sys:Double>
</ResourceDictionary>
